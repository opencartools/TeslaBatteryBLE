<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: AGPL-3.0-only -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The VIN prompt opens the Tesla app (its launcher intent) so the owner can copy the VIN from it. -->
    <queries>
        <package android:name="com.teslamotors.tesla" />
    </queries>

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />
    <!-- The system chooser that finds a car without location access, where the phone has it. -->
    <uses-feature
        android:name="android.software.companion_device_setup"
        android:required="false" />

    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!--
      No neverForLocation: that flag makes Android drop beacon-style advertisements, and the cars
      advertise that way (a scan reads plenty of other phones but no Tesla). Without the flag a scan
      needs fine location on Android 12+ too, which the onboarding asks for once.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="${appLabel}"
        android:supportsRtl="true"
        android:theme="@style/Theme.TeslaBatteryBLE">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Restarts tracking after a reboot or an app update. Exported because the system sends the broadcasts. -->
        <receiver
            android:name=".ble.AutoStartReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
          Writes the history to files/battery-history-export/<time>.zip for `adb shell am broadcast`
          (docs/reference/log-pull.md). Only the shell holds the DUMP permission, and the receiver does
          nothing unless the app is debuggable, so a release build never exports.
        -->
        <receiver
            android:name=".history.ExportLogsReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.dzid26.teslable.EXPORT_LOGS" />
            </intent-filter>
        </receiver>

        <service
            android:name=".ble.BleTrackingService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>

</manifest>
