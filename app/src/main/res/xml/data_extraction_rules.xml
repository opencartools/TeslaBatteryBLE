<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+: back up app data (including the vehicle key) only when
     client-side encryption with the device lock secret is available.
     Battery readings are live state, not settings: they stay on the device. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="file" path="battery-history" />
        <exclude domain="file" path="battery-history-export" />
        <exclude domain="database" path="derived.db" />
        <exclude domain="database" path="derived.db-shm" />
        <exclude domain="database" path="derived.db-wal" />
        <exclude domain="database" path="history.db" />
        <exclude domain="database" path="history.db-shm" />
        <exclude domain="database" path="history.db-wal" />
        <exclude domain="database" path="events.db" />
        <exclude domain="database" path="events.db-shm" />
        <exclude domain="database" path="events.db-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="battery-history" />
        <exclude domain="file" path="battery-history-export" />
        <exclude domain="database" path="derived.db" />
        <exclude domain="database" path="derived.db-shm" />
        <exclude domain="database" path="derived.db-wal" />
        <exclude domain="database" path="history.db" />
        <exclude domain="database" path="history.db-shm" />
        <exclude domain="database" path="history.db-wal" />
        <exclude domain="database" path="events.db" />
        <exclude domain="database" path="events.db-shm" />
        <exclude domain="database" path="events.db-wal" />
    </device-transfer>
</data-extraction-rules>
