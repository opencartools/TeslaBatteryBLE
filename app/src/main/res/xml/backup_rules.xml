<?xml version="1.0" encoding="utf-8"?>
<!-- API 27-30 cannot require client-side encryption for backup, so keep the
     vehicle key out of backup here; re-pair with an NFC card tap instead.
     Battery readings are live state, not settings: they stay on the device. -->
<full-backup-content>
    <exclude domain="sharedpref" path="pairing_key.xml" />
    <exclude domain="file" path="battery-history" />
    <exclude domain="database" path="history.db" />
    <exclude domain="database" path="history.db-shm" />
    <exclude domain="database" path="history.db-wal" />
</full-backup-content>
